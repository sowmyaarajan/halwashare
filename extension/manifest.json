{
  "manifest_version": 3,
  "name": "HalwaShare",
  "version": "1.0.0",
  "description": "Open HalwaShare in one click, and right-click any picture, link or text to send it to your room.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Open HalwaShare",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["https://halwashare.onrender.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["https://halwashare.onrender.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
